<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape. A short, wide screen is used as two panes instead of a squashed copy of the
     portrait column: a slim top bar (name, tabs, settings), then for each tab a left pane with
     its status and action buttons and a right pane that gives the app list the full height.

     It has the same view ids as res/layout/activity_main.xml, because MainActivity's
     findViewById calls are shared between both layouts. Add or rename an id in both. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/accent_blue"
                android:textStyle="bold"
                android:textSize="20sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textColor="?attr/textSecondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card"
            android:padding="3dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sectionTabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabApps"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="@string/main_all_apps"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:checkable="true"
                    android:checked="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:elevation="0dp"
                    app:strokeWidth="0dp"
                    app:rippleColor="@color/ripple_tint"
                    app:backgroundTint="@color/selector_tab_bg"
                    android:textColor="@color/selector_tab_text"
                    app:cornerRadius="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabQuickList"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="@string/main_quick_list"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:checkable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:elevation="0dp"
                    app:strokeWidth="0dp"
                    app:rippleColor="@color/ripple_tint"
                    app:backgroundTint="@color/selector_tab_bg"
                    android:textColor="@color/selector_tab_text"
                    app:cornerRadius="10dp"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_gear"
            android:contentDescription="@string/main_settings_cd"/>
    </LinearLayout>

    <!-- Shown only when something needs attention (see MainActivity.updatePermissionBanner). -->
    <LinearLayout
        android:id="@+id/rowPermissionWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_warning"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_warning"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/tvPermissionWarning"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/warning_amber"
            android:textSize="12sp"/>

        <ImageButton
            android:id="@+id/btnDismissPermissionWarning"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_small"
            android:tint="@color/warning_amber"
            android:contentDescription="@string/notice_dismiss"/>
    </LinearLayout>

    <!-- One section is visible at a time (see MainActivity.setSection). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== "All apps" ===================== -->
        <LinearLayout
            android:id="@+id/sectionApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Left pane: RAM, system-apps toggle, buttons. Scrolls if the text is enlarged. -->
            <ScrollView
                android:layout_width="@dimen/land_pane_width"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:elevation="2dp"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp">

                                <in.hrishikesh7665.killora.RamGaugeView
                                    android:id="@+id/ramGauge"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>

                                <TextView
                                    android:id="@+id/tvRamPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="@string/main_0"
                                    android:textColor="?attr/textPrimary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"/>
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="12dp">

                                <TextView
                                    android:id="@+id/tvAvailableMemory"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/main_0_gb_free"
                                    android:textColor="@color/accent_green"
                                    android:textSize="15sp"
                                    android:textStyle="bold"/>

                                <ProgressBar
                                    android:id="@+id/progressMemory"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="4dp"
                                    android:layout_marginTop="6dp"
                                    android:progressTint="@color/accent_blue"
                                    android:progressBackgroundTint="?attr/gaugeTrack"
                                    android:max="100"/>

                                <TextView
                                    android:id="@+id/tvLaunchedApps"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/main_0_apps_running"
                                    android:textColor="?attr/textSecondary"
                                    android:textSize="11sp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="2dp"
                            android:background="?attr/gaugeTrack"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/app_badge_system"
                                android:textColor="?attr/textSecondary"
                                android:textSize="12sp"/>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchShowSystem"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:thumbTint="@color/accent_blue"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowEssentialHidden"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_card_warning"
                        android:padding="8dp"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_warning"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"/>

                        <TextView
                            android:id="@+id/tvEssentialHidden"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/warning_amber"
                            android:textSize="11sp"/>

                        <ImageButton
                            android:id="@+id/btnDismissEssentialHidden"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="11dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_close_small"
                            android:tint="@color/warning_amber"
                            android:contentDescription="@string/notice_dismiss"/>
                    </LinearLayout>

                    <!-- Pushes the buttons to the bottom when there is room. -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveQuickList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/quick_add_selected"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        app:strokeColor="@color/accent_blue"
                        android:textColor="@color/accent_blue"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:cornerRadius="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloseSelected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="6dp"
                        android:text="@string/main_close_selected"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_force_stop"
                        app:iconTint="@android:color/white"
                        app:iconGravity="textStart"
                        android:backgroundTint="@color/danger_red"
                        app:cornerRadius="12dp"/>
                </LinearLayout>
            </ScrollView>

            <!-- Right pane: the list, with the full height of the screen. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tvAppListHeader"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/main_all_apps"
                        android:textColor="?attr/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"/>

                    <ImageButton
                        android:id="@+id/btnSearchApps"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_search"
                        android:tint="?attr/textSecondary"
                        android:contentDescription="@string/main_search_cd"/>

                    <ImageButton
                        android:id="@+id/btnRefreshApps"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_refresh"
                        android:contentDescription="@string/main_refresh_app_list_cd"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowAppSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etAppSearch"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/main_search_hint"
                        android:importantForAutofill="no"
                        android:textColor="?attr/textPrimary"
                        android:textColorHint="?attr/textSecondary"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionSearch|flagNoExtractUi"/>

                    <ImageButton
                        android:id="@+id/btnCloseAppSearch"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close_small"
                        android:tint="?attr/textSecondary"
                        android:contentDescription="@string/notice_dismiss"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                        android:id="@+id/swipeRefresh"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerApps"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingBottom="4dp"/>

                    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                    <ProgressBar
                        android:id="@+id/progressListRefresh"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_gravity="top"
                        android:indeterminate="true"
                        android:progressTint="@color/accent_blue"
                        android:progressBackgroundTint="@android:color/transparent"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tvAppsSearchNoResults"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/main_search_no_results"
                        android:textColor="?attr/textSecondary"
                        android:textSize="13sp"
                        android:visibility="gone"/>

                    <!-- "Preparing your apps" cover, see MainActivity.updateAppsLoadingState(). -->
                    <LinearLayout
                        android:id="@+id/loadingAppsState"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/appBg"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="visible">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressAppsLoading"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginBottom="12dp"
                            android:indeterminate="true"
                            app:indicatorColor="@color/accent_blue"
                            app:trackColor="?attr/gaugeTrack"
                            app:trackThickness="3dp"
                            app:indicatorSize="36dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_preparing_your_apps"
                            android:textColor="?attr/textPrimary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/main_scanning_installed_apps_and_checking"
                            android:textColor="?attr/textSecondary"
                            android:textSize="12sp"/>
                    </LinearLayout>

                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== "Quick List" ===================== -->
        <LinearLayout
            android:id="@+id/sectionQuickList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Left pane: what it is, how to change it, and the close button. -->
            <ScrollView
                android:layout_width="@dimen/land_pane_width"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/quick_description"
                        android:textColor="?attr/textSecondary"
                        android:textSize="12sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddApps"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/quick_add_apps"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:textColor="@color/accent_blue"
                            app:icon="@drawable/ic_add"
                            app:iconTint="@color/accent_blue"
                            app:iconGravity="textStart"
                            app:strokeColor="@color/accent_blue"
                            app:cornerRadius="12dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearQuickList"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:layout_marginStart="6dp"
                            android:text="@string/quick_clear_all"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:textColor="@color/danger_red"
                            app:rippleColor="@color/ripple_tint_danger"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowQuickShowStopped"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/quick_show_stopped"
                            android:textColor="?attr/textPrimary"
                            android:textSize="13sp"/>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchQuickShowStopped"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/accent_blue"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloseQuickList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/quick_close_selected"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_force_stop"
                        app:iconTint="@android:color/white"
                        app:iconGravity="textStart"
                        app:cornerRadius="12dp"
                        android:backgroundTint="@color/accent_purple"
                        android:visibility="gone"/>
                </LinearLayout>
            </ScrollView>

            <!-- Right pane: title row and the list. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/main_quick_list"
                        android:textColor="?attr/textPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvQuickListCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text=""
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickSelectAll"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/quick_select_all"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_blue"
                        android:visibility="gone"/>

                    <ImageButton
                        android:id="@+id/btnSearchQuickList"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_search"
                        android:tint="?attr/textSecondary"
                        android:contentDescription="@string/quick_list_search_cd"/>

                    <ImageButton
                        android:id="@+id/btnQuickMore"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_more_vert"
                        android:contentDescription="@string/quick_more_cd"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowQuickSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etQuickSearch"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/quick_list_search_hint"
                        android:importantForAutofill="no"
                        android:textColor="?attr/textPrimary"
                        android:textColorHint="?attr/textSecondary"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionSearch|flagNoExtractUi"/>

                    <ImageButton
                        android:id="@+id/btnCloseQuickSearch"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close_small"
                        android:tint="?attr/textSecondary"
                        android:contentDescription="@string/notice_dismiss"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerQuickList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tvQuickListEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/quick_empty"
                        android:textColor="?attr/textSecondary"
                        android:textSize="13sp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tvQuickSearchNoResults"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/quick_list_search_no_results"
                        android:textColor="?attr/textSecondary"
                        android:textSize="13sp"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
