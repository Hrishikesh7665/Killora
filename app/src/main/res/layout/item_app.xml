<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_ripple"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <ImageView
        android:id="@+id/imgIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_frame"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="4dp">

        <TextView
            android:id="@+id/tvLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/textPrimary"
            android:textSize="15sp"/>

        <!-- Always shown (not just on demand) so you never have to dig into App Info to see
             which package/version you're about to close. -->
        <TextView
            android:id="@+id/tvPackageVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="middle"
            android:textColor="?attr/textSecondary"
            android:textSize="11sp"/>

        <!-- Always visible, never greyed/disabled: a status dot + text replaces the old
             "grey out the whole row and disable the checkbox" approach for apps that
             aren't currently running. The row stays fully interactive either way. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginStart="6dp"
                android:visibility="gone"/>

            <!-- Shown for apps already saved in the Quick List. -->
            <ImageView
                android:id="@+id/imgQuickBadge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_pin"
                android:contentDescription="@string/quick_badge_description"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnAppSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_settings_gear"
        android:contentDescription="@string/app_item_open_app_settings_cd"/>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:buttonTint="@color/accent_blue"/>

</LinearLayout>
