<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="@dimen/screen_padding"
    android:paddingBottom="12dp"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/card_spacing">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/accent_blue"
                android:textStyle="bold"
                android:textSize="@dimen/header_title_size"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textColor="?attr/textSecondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_gear"
            android:contentDescription="@string/main_settings_cd"/>
    </LinearLayout>

    <!-- Shown only when something needs the user's attention: root access denied with a
         root manager present, or deep force stop on without Accessibility enabled yet.
         Dismissible: tapping the X hides it until the underlying condition changes (it
         re-appears if a *different* problem shows up, since that's new information). -->
    <LinearLayout
        android:id="@+id/rowPermissionWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_warning"
        android:padding="12dp"
        android:layout_marginBottom="@dimen/card_spacing"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_warning"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/tvPermissionWarning"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/warning_amber"
            android:textSize="12sp"/>

        <ImageButton
            android:id="@+id/btnDismissPermissionWarning"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:padding="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_small"
            android:tint="@color/warning_amber"
            android:contentDescription="@string/notice_dismiss"/>
    </LinearLayout>

    <!-- Section switcher: only one of "Apps" / "Quick List" is shown at a time, so the
         screen never has to stack both lists on top of each other. Styled as a filled
         segmented control (selector_tab_bg/selector_tab_text) so the active tab is
         unmistakable at a glance, rather than relying on the subtle default outline. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/card_spacing"
        android:background="@drawable/bg_card"
        android:padding="4dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sectionTabs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabApps"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@string/main_all_apps"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:checkable="true"
                android:checked="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:elevation="0dp"
                app:strokeWidth="0dp"
                app:rippleColor="@color/ripple_tint"
                app:backgroundTint="@color/selector_tab_bg"
                android:textColor="@color/selector_tab_text"
                app:cornerRadius="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabQuickList"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@string/main_quick_list"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:checkable="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:elevation="0dp"
                app:strokeWidth="0dp"
                app:rippleColor="@color/ripple_tint"
                app:backgroundTint="@color/selector_tab_bg"
                android:textColor="@color/selector_tab_text"
                app:cornerRadius="10dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <!-- Only one child of this frame is visible at a time (see MainActivity.setSection). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== "All apps" section ===================== -->
        <LinearLayout
            android:id="@+id/sectionApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Compact status strip: RAM gauge + stats and the system-apps toggle now share
                 ONE slim card instead of two full-height cards stacked on top of each other.
                 That alone gives the scrollable app list well over 100dp of extra height on a
                 typical phone - see Part 4 notes in the PR/README for the before/after. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp">

                    <in.hrishikesh7665.killora.RamGaugeView
                        android:id="@+id/ramGauge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <TextView
                        android:id="@+id/tvRamPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/main_0"
                        android:textColor="?attr/textPrimary"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvAvailableMemory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_0_gb_free"
                        android:textColor="@color/accent_green"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <ProgressBar
                        android:id="@+id/progressMemory"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:progressTint="@color/accent_blue"
                        android:progressBackgroundTint="?attr/gaugeTrack"
                        android:max="100"/>

                    <TextView
                        android:id="@+id/tvLaunchedApps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/main_0_apps_running"
                        android:textColor="?attr/textSecondary"
                        android:textSize="11sp"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="?attr/gaugeTrack"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_badge_system"
                        android:textColor="?attr/textSecondary"
                        android:textSize="10sp"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchShowSystem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        app:thumbTint="@color/accent_blue"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowEssentialHidden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_warning"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_warning"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"/>

                <TextView
                    android:id="@+id/tvEssentialHidden"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/warning_amber"
                    android:textSize="12sp"/>

                <ImageButton
                    android:id="@+id/btnDismissEssentialHidden"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close_small"
                    android:tint="@color/warning_amber"
                    android:contentDescription="@string/notice_dismiss"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvAppListHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/main_all_apps"
                    android:textColor="?attr/textSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"/>

                <ImageButton
                    android:id="@+id/btnSearchApps"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="2dp"
                    android:padding="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/main_search_cd"/>

                <ImageButton
                    android:id="@+id/btnRefreshApps"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="@string/main_refresh_app_list_cd"/>
            </LinearLayout>

            <!-- Hidden until the search icon above is tapped. A plain EditText row, matching the
                 one already used in dialog_add_apps.xml, rather than a second RecyclerView or
                 dialog - filtering happens in place, on the same list. -->
            <LinearLayout
                android:id="@+id/rowAppSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etAppSearch"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/main_search_hint"
                    android:textColor="?attr/textPrimary"
                    android:textColorHint="?attr/textSecondary"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"/>

                <ImageButton
                    android:id="@+id/btnCloseAppSearch"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close_small"
                    android:contentDescription="@string/notice_dismiss"/>
            </LinearLayout>

            <!-- The thin progress bar overlays the top edge of the list area (FrameLayout,
                 no extra height reserved) so it never shifts the list or the buttons below it
                 when it appears/disappears during a background refresh - purely a "something
                 is updating" cue, never a layout-jumping or interaction-blocking one. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerApps"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="4dp"/>

                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <ProgressBar
                    android:id="@+id/progressListRefresh"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_gravity="top"
                    android:indeterminate="true"
                    android:progressTint="@color/accent_blue"
                    android:progressBackgroundTint="@android:color/transparent"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvAppsSearchNoResults"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="40dp"
                    android:text="@string/main_search_no_results"
                    android:textColor="?attr/textSecondary"
                    android:textSize="13sp"
                    android:visibility="gone"/>

                <!-- Full-screen "preparing the list" state: shown on the very first launch
                     (before the first background scan has ever completed) and any time a scan
                     leaves the list with nothing to show, so the user always sees an obvious
                     "still working on it" cue instead of a blank screen. Solid background so it
                     fully covers the empty list/buttons behind it. See
                     MainActivity.updateAppsLoadingState(). -->
                <LinearLayout
                    android:id="@+id/loadingAppsState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/appBg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="visible">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressAppsLoading"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="18dp"
                        android:indeterminate="true"
                        app:indicatorColor="@color/accent_blue"
                        app:trackColor="?attr/gaugeTrack"
                        app:trackThickness="4dp"
                        app:indicatorSize="40dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_preparing_your_apps"
                        android:textColor="?attr/textPrimary"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/main_scanning_installed_apps_and_checking"
                        android:textColor="?attr/textSecondary"
                        android:textSize="12sp"/>

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveQuickList"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/quick_add_selected"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    app:strokeColor="@color/accent_blue"
                    android:textColor="@color/accent_blue"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="14dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseSelected"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    android:text="@string/main_close_selected"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_force_stop"
                    app:iconTint="@android:color/white"
                    app:iconGravity="textStart"
                    android:backgroundTint="@color/danger_red"
                    app:cornerRadius="14dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ===================== "Quick List" section ===================== -->
        <LinearLayout
            android:id="@+id/sectionQuickList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/main_quick_list"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvQuickListCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text=""
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickSelectAll"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/quick_select_all"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_blue"
                    android:visibility="gone"/>

                <ImageButton
                    android:id="@+id/btnSearchQuickList"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/quick_list_search_cd"/>
            </LinearLayout>

            <!-- Hidden until the search icon above is tapped. See rowAppSearch for the same
                 pattern on the Apps tab. -->
            <LinearLayout
                android:id="@+id/rowQuickSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etQuickSearch"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/quick_list_search_hint"
                    android:textColor="?attr/textPrimary"
                    android:textColorHint="?attr/textSecondary"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"/>

                <ImageButton
                    android:id="@+id/btnCloseQuickSearch"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close_small"
                    android:contentDescription="@string/notice_dismiss"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/quick_description"
                android:textColor="?attr/textSecondary"
                android:textSize="12sp"/>

            <!-- Quick List management: add apps from a picker, or clear the whole list. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddApps"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="@string/quick_add_apps"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_blue"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/accent_blue"
                    app:iconGravity="textStart"
                    app:strokeColor="@color/accent_blue"
                    app:cornerRadius="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearQuickList"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/quick_clear_all"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:textColor="@color/danger_red"
                    app:rippleColor="@color/ripple_tint_danger"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- On by default (see Prefs.getQuickListShowStopped), so turning it off is an
                 explicit, reversible choice to declutter rather than something hiding apps
                 without the user asking for that. -->
            <LinearLayout
                android:id="@+id/rowQuickShowStopped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_show_stopped"
                    android:textColor="?attr/textPrimary"
                    android:textSize="13sp"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchQuickShowStopped"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/accent_blue"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuickListEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/quick_empty"
                android:textColor="?attr/textSecondary"
                android:textSize="13sp"
                android:visibility="gone"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerQuickList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvQuickSearchNoResults"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="40dp"
                    android:text="@string/quick_list_search_no_results"
                    android:textColor="?attr/textSecondary"
                    android:textSize="13sp"
                    android:visibility="gone"/>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseQuickList"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/quick_close_selected"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:icon="@drawable/ic_force_stop"
                app:iconTint="@android:color/white"
                app:iconGravity="textStart"
                app:cornerRadius="14dp"
