<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/cardBg"/>
    <corners android:radius="16dp"/>
    <!-- Subtle 1dp accent-tinted border so cards read as distinct surfaces against the
         background in every theme, instead of relying on fill-color contrast alone. -->
    <stroke android:width="1dp" android:color="@color/ripple_tint"/>
</shape>
